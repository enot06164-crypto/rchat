{
  "name": "rchat-web",
  "private": true,
  "version": "0.1.0",
  "description": "Web client for rchat in the Telegram WebK style (SolidJS + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-solid": "^0.454.0",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "sass": "^1.80.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^2.1.9"
  }
}
